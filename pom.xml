<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Standalone parent POM for tp-demo, kept in its own repository. It is
        built and installed on its own (mvn install) and child projects resolve
        it from the Maven repository by its coordinates, not through relativePath.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.11</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>tp-demo-standalone-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>tp-demo-standalone-parent</name>
    <description>Standalone parent POM for tp-demo</description>

    <properties>
        <java.version>11</java.version>
        <!-- Keep in sync with the spring-boot-starter-parent version above -->
        <spring-boot.version>2.7.11</spring-boot.version>
    </properties>

    <!-- Inherited by every child project -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>
</project>
